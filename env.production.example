# Шаблон /opt/vehicle_tracker_api/.env на хості rubin. Значення не комітити.
# Коментарів із паролями у цьому файлі не тримати.

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=warehouse.mom,www.warehouse.mom

DB_NAME=vehicle_tracker
DB_USER=vehicle_app
DB_PASSWORD=
DB_HOST=rubin-postgres-container
DB_PORT=5432

CORS_ALLOWED_ORIGINS=https://warehouse.mom
CSRF_TRUSTED_ORIGINS=https://warehouse.mom

# Без цих значень листи лише друкуються в лог контейнера
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=

# Бот @driver_car_bot: токен узяти в @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
